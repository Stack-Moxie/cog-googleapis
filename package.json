{
  "name": "cog-google-apis",
  "version": "0.1.0",
  "description": "Google APIs Cog for use with Crank",
  "license": "MIT",
  "cog": {
    "name": "stackmoxie/googleapis",
    "label": "Google APIs",
    "homepage": "https://github.com/Stack-Moxie/cog-googleapis",
    "authHelpUrl": ""
  },
  "scripts": {
    "build-docker": "docker build -t stackmoxie/googleapis:$npm_package_version -t stackmoxie/googleapis:latest .",
    "build-proto": "scripts/build-proto.sh",
    "build-ts": "tsc",
    "lint": "eslint --ext .ts src/client src/steps",
    "start": "check-engine package.json && ts-node src/core/grpc-server.ts",
    "test": "nyc mocha -r ts-node/register test/*.ts test/**/*.ts test/**/**/*.ts",
    "version": "crank cog:readme stackmoxie/googleapis && git add README.md"
  },
  "nyc": {
    "extension": [
      ".ts"
    ],
    "exclude": [
      "**/*.d.ts",
      "test/**/*.ts",
      "**/*.js",
      "src/core/grpc-server.ts"
    ],
    "reporter": [
      "html",
      "text"
    ],
    "all": true
  },
  "engines": {
    "node": ">= 10.0.0"
  },
  "devDependencies": {
    "@types/chai": "^4.1.7",
    "@types/google-protobuf": "^3.2.7",
    "@types/mocha": "^5.2.7",
    "@types/needle": "^2.0.4",
    "@types/node": "^12.0.4",
    "chai": "^4.2.0",
    "check-engine": "^1.8.1",
    "eslint": "^8.54.0",
    "eslint-config-airbnb": "^19.0.4",
    "grpc_tools_node_protoc_ts": "^4.0.0",
    "grpc-tools": "^1.9.0",
    "mocha": "^7.2.0",
    "nyc": "^14.1.1",
    "sinon-chai": "^3.3.0",
    "ts-sinon": "^1.0.17",
    "typescript": "^5.3.2"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.9.13",
    "@run-crank/utilities": "^0.5.2",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "chai-as-promised": "^7.1.1",
    "google-auth-library": "^9.4.1",
    "google-protobuf": "^3.8.0",
    "googleapis": "^129.0.0",
    "mailgun-js": "^0.22.0",
    "needle": "^2.5.0",
    "redis": "^4.6.12",
    "ts-node": "^8.3.0"
  }
}
